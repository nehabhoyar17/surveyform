@model List<SurveyApp.Models.SurveyResponse>
@{
    ViewData["Title"] = "Admin - Survey Responses";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Survey Responses (@Model.Count)</h3>
        <form method="get" class="d-flex" style="max-width:300px;">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2" placeholder="Search name or email" />
            <button class="btn btn-primary">Search</button>
        </form>
    </div>

    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Name</th><th>Email</th><th>City</th><th>Submitted</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.FullName</td>
                        <td>@r.Email</td>
                        <td>@r.City</td>
                        <td>@r.SubmittedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">View</a>
                            <a asp-controller="Survey" asp-action="DownloadPdf" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">PDF</a>
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this response?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>