@model SurveyApp.Models.SurveyResponse
@{
    ViewData["Title"] = "Thank You";
}

<div class="container my-5">
    <div class="success-card mx-auto" style="max-width: 600px;">
        <i class="bi bi-check-circle-fill success-icon"></i>
        <h2 class="fw-bold mt-3">Thank You, @Model.FullName!</h2>
        <p class="text-muted">Your survey response has been submitted successfully on @Model.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt").</p>
        <p class="text-muted">A copy of your response has been saved and emailed to our team as a PDF.</p>

        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-controller="Survey" asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-download me-1"></i> Download My PDF
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-fill me-1"></i> Back to Home
            </a>
        </div>
    </div>
</div>